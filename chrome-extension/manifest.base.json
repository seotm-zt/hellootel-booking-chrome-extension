{
    "manifest_version": 3,
    "version": "1.2.3",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions_extra": [
        "https://booking-configurator.hellootel.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "js": [
                "auth.js",
                "parsers/currency-utils.js",
                "booking-modal.js",
                "parsers/registry.js",
                "parsers/config-engine.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ]
}
